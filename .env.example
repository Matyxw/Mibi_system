# PostgreSQL Supabase Transaction Pooler (puerto 6543) — requerido en producción
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# PostgreSQL Supabase Direct Connection (puerto 5432) — solo para migraciones / drizzle-kit
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Clave secreta JWT (>= 32 bytes, generar con: openssl rand -base64 32)
AUTH_SECRET="reemplazar-con-secreto-aleatorio-de-al-menos-32-bytes"

# Contraseñas iniciales para scripts/seed.ts
ADMIN_INITIAL_PASSWORD=""
VENTAS_INITIAL_PASSWORD=""
